      {
        "name": "The Opaque Fallback Rule",
        "body": "Preserve the reduce-transparency setting and the reduced-transparency/increased-contrast media fallbacks. Workspace material becomes the solid surface; the island becomes solid dark with an outline.",
        "section": "elevation"
      }
