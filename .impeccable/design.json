  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Main save or send action; send uses its own narrower padding.",
      "html": "<button class=\"ds-button ds-primary\">Save provider</button>",
      "css": ".ds-button{font:600 15px -apple-system,BlinkMacSystemFont,'Segoe UI Variable','Segoe UI',sans-serif;border:0;cursor:pointer;min-height:44px;padding:11px 21px;border-radius:24px;transition:background-color 140ms ease,transform 120ms cubic-bezier(.23,1,.32,1)}.ds-primary{background:var(--blue,#0765d8);color:#fff}.ds-primary:hover{background:#0759bc}.ds-button:active{transform:scale(.97)}.ds-button:focus-visible,.ds-input:focus-visible,.ds-nav button:focus-visible,.ds-switch:focus-visible,.ds-island:focus-visible{outline:3px solid var(--blue,#0765d8);outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}"
    },
    {
      "name": "Plain action",
      "kind": "button",
      "refersTo": "button-plain",
      "description": "Secondary text action with a visible press area.",
      "html": "<button class=\"ds-button\">Show desktop island</button>",
      "css": ".ds-button{font:500 13px -apple-system,BlinkMacSystemFont,'Segoe UI Variable','Segoe UI',sans-serif;color:var(--blue,#0765d8);background:transparent;border:0;border-radius:13px;min-height:44px;padding:10px 14px;cursor:pointer;transition:background-color 140ms ease,transform 120ms cubic-bezier(.23,1,.32,1)}.ds-button:hover{background:#e4eaf5}.ds-button:active{transform:scale(.97);background:#dce5f3}.ds-button:focus-visible,.ds-input:focus-visible,.ds-nav button:focus-visible,.ds-switch:focus-visible,.ds-island:focus-visible{outline:3px solid var(--blue,#0765d8);outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}"
    },
    {
      "name": "Settings input",
      "kind": "input",
      "description": "Labeled vertical endpoint field within an opaque settings group.",
      "html": "<div class=\"ds-field\"><label for=\"ds-base\">API base URL</label><input class=\"ds-input\" id=\"ds-base\" type=\"url\" placeholder=\"https://your-provider.example/v1\"></div>",
      "css": ".ds-field{padding:12px 18px;background:var(--surface,#fff);color:var(--ink,#18202d);border-radius:18px;font:15px -apple-system,BlinkMacSystemFont,'Segoe UI Variable','Segoe UI',sans-serif;display:flex;flex-direction:column;gap:5px}.ds-input{font:14px -apple-system,BlinkMacSystemFont,'Segoe UI Variable','Segoe UI',sans-serif;padding:10px 0;border:0;background:transparent;color:var(--ink,#18202d);caret-color:var(--blue,#0765d8);width:100%;min-width:0}.ds-input::placeholder{color:var(--muted,#5f6877);opacity:1}.ds-button:focus-visible,.ds-input:focus-visible,.ds-nav button:focus-visible,.ds-switch:focus-visible,.ds-island:focus-visible{outline:3px solid var(--blue,#0765d8);outline-offset:3px}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "description": "A representative selected destination from the four labeled destinations.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Main sections\"><button aria-current=\"page\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m3 10 9-7 9 7v10H3Z M9 20v-7h6v7\"/></svg><span>Home</span></button><button>Missions</button><button>Memory</button><button>Settings</button></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:5px;padding:15px;background:var(--glass,rgba(252,252,255,.82));backdrop-filter:blur(22px) saturate(1.25);border-radius:18px}.ds-nav button{display:flex;align-items:center;gap:12px;font:500 15px -apple-system,BlinkMacSystemFont,'Segoe UI Variable','Segoe UI',sans-serif;color:var(--ink,#18202d);padding:11px 15px;min-height:48px;text-align:left;background:transparent;border:0;border-radius:13px;cursor:pointer}.ds-nav button[aria-current]{background:var(--selected,#e8eefb);font-weight:600}.ds-nav button:hover{background:var(--selected,#e8eefb)}.ds-nav button:active{transform:scale(.97)}.ds-nav svg{width:23px;height:23px;fill:none;stroke:var(--blue,#0765d8);stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.ds-button:focus-visible,.ds-input:focus-visible,.ds-nav button:focus-visible,.ds-switch:focus-visible,.ds-island:focus-visible{outline:3px solid var(--blue,#0765d8);outline-offset:3px}@media(prefers-reduced-transparency:reduce),(prefers-contrast:more){.ds-nav{background:var(--surface,#fff);backdrop-filter:none}}"
    },
    {
      "name": "Grouped content",
      "kind": "card",
      "refersTo": "group",
      "description": "Opaque grouped connection state with supporting copy.",
      "html": "<div class=\"ds-group\"><strong>No services connected</strong><p>MCP tools and a separately authorized Gmail connection are planned.</p></div>",
      "css": ".ds-group{background:var(--surface,#fff);color:var(--ink,#18202d);border-radius:18px;padding:17px 19px;font:15px -apple-system,BlinkMacSystemFont,'Segoe UI Variable','Segoe UI',sans-serif}.ds-group strong{font-weight:500}.ds-group p{font-size:14px;color:var(--muted,#5f6877);line-height:1.7;margin-bottom:0}"
    },
    {
      "name": "Labeled switch",
      "kind": "custom",
      "description": "Native checkbox semantics with the source's green enabled state.",
      "html": "<label class=\"ds-switch-row\">Include my memory<input class=\"ds-switch\" type=\"checkbox\"></label>",
      "css": ".ds-switch-row{display:flex;align-items:center;justify-content:space-between;gap:14px;font:13px -apple-system,BlinkMacSystemFont,'Segoe UI Variable','Segoe UI',sans-serif;color:var(--muted,#5f6877)}.ds-switch{appearance:none;position:relative;width:44px;height:27px;flex-shrink:0;padding:0;border:0;border-radius:16px;background:#c7cbd2;cursor:pointer;transition:background-color 160ms ease}.ds-switch::before{content:'';position:absolute;width:23px;height:23px;top:2px;left:2px;border-radius:50%;background:#fff;box-shadow:0 2px 5px #192b4725;transition:transform 160ms cubic-bezier(.23,1,.32,1)}.ds-switch:checked{background:#24824e}.ds-switch:checked::before{transform:translateX(17px)}.ds-button:focus-visible,.ds-input:focus-visible,.ds-nav button:focus-visible,.ds-switch:focus-visible,.ds-island:focus-visible{outline:3px solid var(--blue,#0765d8);outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-switch,.ds-switch::before{transition:none}}"
    },
    {
      "name": "Compact companion",
      "kind": "custom",
      "refersTo": "island",
      "description": "Compact visual toggle; full expansion requires the native application bridge.",
      "html": "<button class=\"ds-island\" aria-expanded=\"false\"><svg viewBox=\"0 0 48 48\" aria-hidden=\"true\"><path d=\"M12 9v30M14 27 35 9M21 21l16 18\" stroke=\"currentColor\" stroke-width=\"7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><circle cx=\"37\" cy=\"12\" r=\"3\" fill=\"currentColor\"/></svg><span>Kivou is here</span><i></i></button>",
