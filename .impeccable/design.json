  "narrative": {
    "northStar": "A little room to think",
    "overview": "Kivou combines a quiet, opaque work canvas with a small translucent companion. The owner's chosen iOS direction appears in large titles, inset grouped settings, labeled switches and four stable destinations. Wide Windows layouts adapt those destinations to a sidebar; narrow windows use floating bottom tabs.\n\nThe material is a custom Electron/CSS approximation. The original K mark and rayaneDR attribution remain Kivou's identity. The system does not imply Apple affiliation, native Apple lensing or desktop blur through the transparent island. The north star uses existing interface language rather than introducing a new brand metaphor.",
    "keyCharacteristics": [
      "System typography and restrained blue actions.",
      "Opaque conversation, permission and settings surfaces.",
      "Persistent labeled navigation and an optional compact companion.",
      "Brief press feedback, explicit reduced motion and opaque fallbacks."
    ],
    "rules": [
      {
        "name": "The Readable Canvas Rule",
        "body": "Keep conversation and permission content on opaque surfaces; reserve translucent material for navigation, the model control and companion.",
        "section": "colors"
